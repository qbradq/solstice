game := import("game")

attacker := game.get_actor(source_id)
target := game.get_actor(target_id)

if attacker != undefined && target != undefined {
	level_diff := attacker["level"] - target["level"]
	hit_chance := 80

	if level_diff > 0 {
		hit_chance = 90
	} else if level_diff < 0 {
		hit_chance = 80 + (level_diff * 20)
		if hit_chance < 10 {
			hit_chance = 10
		}
	}

	roll := game.roll("1d100")

	if roll <= hit_chance {
		str := attacker["strength"]
		str_bonus := 0
		if str <= 6 {
			str_bonus = -3
		} else if str <= 8 {
			str_bonus = -2
		} else if str <= 10 {
			str_bonus = -1
		} else if str <= 14 {
			str_bonus = 0
		} else if str <= 16 {
			str_bonus = 1
		} else if str <= 18 {
			str_bonus = 2
		} else {
			str_bonus = 3
		}

		damage_formula := attacker["damage"]
		if damage_formula == undefined || damage_formula == "" {
			damage_formula = "1d4"
		}

		damage := game.roll(damage_formula) + str_bonus
		if damage < 1 {
			damage = 1
		}

		game.damage_actor(target["id"], damage)

		game.log("%s hits %s for %d damage!", attacker["name"], target["name"], damage)
	} else {
		game.log("%s misses %s!", attacker["name"], target["name"])
	}
}

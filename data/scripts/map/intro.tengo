game := import("game")

// Spawn Duke Lafey and his court mages.
game.spawn_actor("wizard", "wizard-1", 7, 6)
game.spawn_actor("wizard", "wizard-2", 6, 7)
game.spawn_actor("wizard", "wizard-3", 8, 7)
game.spawn_actor("duke_lafey", "duke-lafey", 7, 8)

// Start introductory dialog. 
game.start_dialog("dialog/intro.tengo", "duke-lafey")
